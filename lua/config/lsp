  priority = 100,
  cmd = { "clangd" },
  filetypes = { "c", "cpp", "cuda", "objc", "objcpp" },
  root_markers = { "compile_commands.json", ".git" },
  capabilities = capabilities,
  on_attach = on_attach,
})

